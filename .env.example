# Copia este archivo a .env (o .env.local) y completa los valores desde:
# Firebase Console > Configuración del proyecto > Tus apps > Configuración del SDK (app web)
# Estos valores NO son secretos (identifican el proyecto); la seguridad real la dan las Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
