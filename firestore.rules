rules_version = '2';

/**
 * PYMES – PALMER · Firestore Security Rules
 *
 * Principios
 *  - Nada se confía al frontend: el rol se valida AQUÍ (documento users/{uid}.role o custom claim admin=true).
 *  - Jugador: lee/edita solo SU perfil (nombre, avatar, tema), crea SUS partidas/respuestas y lee contenido ACTIVO.
 *  - Administrador: gestiona contenido, parámetros, logros, jugadores y consulta todo.
 *  - Categorías, temas y preguntas NO se pueden borrar (se desactivan) → el histórico nunca se pierde.
 *  - Las respuestas y los logros usan ids deterministas y son de solo creación → no se duplican.
 *  - publicProfiles (ranking) es lo único que ven otros jugadores: sin correo ni datos privados.
 *
 * LIMITACIÓN CONOCIDA (documentada en README): las estadísticas (XP, nivel…) las calcula el cliente
 * dentro de una transacción. Estas reglas acotan los incrementos por partida y bloquean cambios de rol/estado,
 * pero para una competencia con premios se recomienda mover el cálculo a una Cloud Function.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------ helpers ------------------------------ */
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isOwner(id) { return signedIn() && request.auth.uid == id; }
    function userPath(id) { return /databases/$(database)/documents/users/$(id); }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (exists(userPath(request.auth.uid)) && get(userPath(request.auth.uid)).data.role == 'admin')
      );
    }
    function isActiveUser() {
      return signedIn() && exists(userPath(request.auth.uid)) &&
             get(userPath(request.auth.uid)).data.status == 'active';
    }
    function delta(field) { return request.resource.data[field] - resource.data[field]; }

    /* ------------------------------- users ------------------------------- */
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.role == 'player'
        && request.resource.data.status == 'active'
        && request.resource.data.xp == 0
        && request.resource.data.gamesPlayed == 0
        && request.resource.data.totalAnswered == 0
        && request.resource.data.email.lower() == request.auth.token.email.lower();

      allow update: if isAdmin() || (
        isOwner(userId)
        && resource.data.status == 'active'
        && request.resource.data.id == resource.data.id
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && delta('xp') >= 0 && delta('xp') <= 50000
        && delta('gamesPlayed') >= 0 && delta('gamesPlayed') <= 1
        && delta('totalAnswered') >= 0 && delta('totalAnswered') <= 200
        && delta('totalCorrect') >= 0 && delta('totalCorrect') <= delta('totalAnswered')
      );

      allow delete: if false;

      // Estadísticas privadas del jugador (dominio por tema, historial por pregunta, partida en curso)
      match /topicStats/{id} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /questionStats/{id} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /activeGame/{id} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
    }

    /* --------------------- publicProfiles (ranking) ---------------------- */
    match /publicProfiles/{id} {
      allow read: if signedIn();
      allow create: if isOwner(id)
        && request.resource.data.uid == id
        && request.resource.data.xp == 0
        && request.resource.data.status == 'active';
      allow update: if isAdmin() || (
        isOwner(id)
        && request.resource.data.uid == id
        && request.resource.data.status == resource.data.status
        && request.resource.data.xp == getAfter(userPath(id)).data.xp
        && request.resource.data.gamesPlayed == getAfter(userPath(id)).data.gamesPlayed
      );
      allow delete: if false;
    }

    /* -------------------- contenido: categorías y temas ------------------- */
    match /categories/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /topics/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    /* ------------------------------ preguntas ----------------------------- */
    match /questions/{id} {
      // los jugadores solo ven preguntas activas (las consultas deben incluir where active == true)
      allow read: if signedIn() && (resource.data.active == true || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isActiveUser()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['timesShown', 'timesAnswered', 'timesCorrect', 'timesTimeout'])
        && delta('timesShown') <= 1 && delta('timesAnswered') <= 1
        && delta('timesCorrect') <= 1 && delta('timesTimeout') <= 1
      );
      allow delete: if false;
    }

    /* ------------------------------- partidas ------------------------------ */
    match /games/{id} {
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isActiveUser() && request.resource.data.userId == uid();
      // una vez completada, la partida es inmutable
      allow update: if isActiveUser()
        && resource.data.userId == uid()
        && request.resource.data.userId == uid()
        && resource.data.completed == false;
      allow delete: if false;
    }

    // id determinista gameId_index → imposible duplicar una respuesta; solo creación
    match /answers/{id} {
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isActiveUser()
        && request.resource.data.userId == uid()
        && id == request.resource.data.gameId + '_' + string(request.resource.data.index);
      allow update, delete: if false;
    }

    /* ------------------------ parámetros y logros ------------------------- */
    match /parameters/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /achievements/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    // id determinista uid_logro → un logro no se desbloquea dos veces
    match /userAchievements/{id} {
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isActiveUser()
        && request.resource.data.userId == uid()
        && id == uid() + '_' + request.resource.data.achievementId;
      allow update, delete: if false;
    }

    /* ------------------------------ auditoría ------------------------------ */
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.userId == uid();
      allow update, delete: if false;
    }

    /* -------------------------------- retos -------------------------------- */
    match /challenges/{id} {
      allow read: if signedIn();
      allow create: if isActiveUser()
        && request.resource.data.creatorId == uid()
        && uid() in request.resource.data.playerIds;
      allow update: if isActiveUser()
        && (uid() in resource.data.playerIds ||
            (resource.data.opponentId == null && request.resource.data.opponentId == uid()))
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.code == resource.data.code
        && request.resource.data.items == resource.data.items;
      allow delete: if false;
    }
  }
}
